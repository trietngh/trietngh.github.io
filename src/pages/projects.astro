---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const allProjects = await getCollection("projects");

const parseProjectDate = (startedMonth?: string) => {
	if (!startedMonth) return new Date(0);
	const date = new Date(startedMonth);
	return isNaN(date.getTime()) ? new Date(0) : date;
};

const sortedProjects = allProjects.sort(
	(a, b) =>
		parseProjectDate(b.data.startedMonth).getTime() -
		parseProjectDate(a.data.startedMonth).getTime()
);
---

<BaseLayout title="Projects | Portfolio">
	<div class="py-24">
		<div class="text-center mb-16">
			<h1 class="text-4xl md:text-5xl font-display font-bold text-content-main mb-6">Projects</h1>
			<p class="text-lg text-content-muted max-w-2xl mx-auto">Explore my recent work and personal projects.</p>
		</div>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{sortedProjects.map((project) => (
				<ProjectCard project={project} headingLevel="h2" imageHeightClass="h-64" />
			))}
		</div>

		<div class="mt-16 text-center">
			<a href="/" class="inline-flex items-center gap-2 text-content-muted hover:text-content-main transition-colors">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
				Back to Home
			</a>
		</div>
	</div>
</BaseLayout>
