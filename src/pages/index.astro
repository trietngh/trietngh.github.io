---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout title="Triet Nguyen | Robotics Engineer" maxWidth="max-w-full">
	<!-- Main Center Content -->
	<div class="min-h-screen flex items-center justify-center relative px-4">
		<div
			class="max-w-full w-full flex flex-col md:flex-row items-center justify-start gap-16 md:gap-40 md:pl-24 lg:pl-32 xl:pl-48 z-10"
		>
			<!-- Avatar (Left Side) -->
			<div class="w-128 h-128 md:w-[500px] md:h-[500px] flex-shrink-0">
				<img
					src="/icons/avatar.svg"
					alt="Avatar"
					class="w-full h-full object-contain opacity-95"
				/>
			</div>

			<!-- Text Content (Right Side) -->
			<div class="flex flex-col items-start text-left max-w-3xl">
				<!-- Mars Rover Icon -->
				<div class="w-16 h-16 md:w-32 md:h-32 mb-4">
					<img
						src="/icons/rover.svg"
						alt="Mars Rover"
						class="w-full h-full object-contain"
					/>
				</div>

				<!-- Hello Text -->
				<h1
					class="text-5xl md:text-7xl font-display font-bold text-content-main mb-4 tracking-tight leading-tight"
				>
					Hi, I'm <br class="md:hidden" /><span
						class="text-content-accent">Triet Nguyen</span
					>
				</h1>
				<p
					class="text-2xl md:text-3xl text-content-muted font-sans mb-10"
				>
					A robotics engineer
				</p>

				<!-- Discover Projects Button -->
				<a
					href="/projects"
					class="bg-action-primary text-action-primary-content px-8 py-4 rounded-2xl hover:bg-action-primary-hover transition-colors font-sans font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 duration-200 inline-block mb-10"
				>
					Discover my projects
				</a>

				<!-- Social Links -->
				<div class="flex items-center gap-4">
					<a
						href="https://github.com/trietngh"
						target="_blank"
						rel="noopener noreferrer"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/GitHub_Logos/GitHub_Invertocat_White.svg"
							alt="GitHub"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
						/>
					</a>
					<a
						href="https://linkedin.com/in/triet-nguyen-vn"
						target="_blank"
						rel="noopener noreferrer"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/LinkedIn_icon_circle.svg"
							alt="LinkedIn"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
						/>
					</a>
					<a
						href="mailto:tr_nguye@insa-toulouse.fr.com"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/email-round-solid-icon.svg"
							alt="Email"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
							style="filter: invert(1);"
						/>
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- About Me Section -->
	<section
		id="about"
		class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto z-10 relative"
	>
		<div class="flex flex-col md:flex-row items-center gap-16 md:gap-24">
			<!-- Text Side -->
			<!-- Image Side -->
			<div class="w-full md:w-1/2 flex justify-center">
				<img
					src="/icons/Home(3).png"
					alt="A few words about me"
					class="max-w-full h-auto object-contain rounded-2xl"
				/>
			</div>
			<div class="w-full md:w-1/2 flex flex-col items-start text-left">
				<h2
					class="text-4xl md:text-5xl font-display font-bold text-content-main mb-8"
				>
					A few words <br class="md:hidden" /><span
						class="text-content-accent">about me</span
					>
				</h2>
				<p
					class="text-xl text-content-muted font-sans mb-6 text-justify"
				>
					I'm a robotics engineer passionate about building
					intelligent systems that interact with the physical world.
					My journey in robotics has equipped me with a deep
					understanding of software development, control systems, and
					computer vision.
				</p>
				<p class="text-xl text-content-muted font-sans text-justify">
					I specialize in developing robust algorithms for autonomous
					navigation and perception. I'm always looking for new
					challenges and opportunities to push the boundaries of
					what's possible in robotics.
				</p>
			</div>
		</div>
	</section>

	<!-- Projects Section -->
	<section
		id="projects"
		class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto z-10 relative"
	>
		<div class="text-center mb-16">
			<h2
				class="text-4xl md:text-5xl font-display font-bold text-content-main mb-6"
			>
				My <span class="text-content-accent">Projects</span>
			</h2>
			<p class="text-xl text-content-muted max-w-2xl mx-auto">
				Here are some of my favorite projects I've worked on.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{featuredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>

		<div class="mt-16 text-center">
			<a
				href="/projects"
				class="border border-action-secondary-border text-action-secondary-content px-8 py-4 rounded-full hover:bg-action-secondary-hover transition-colors font-sans font-bold text-lg inline-block shadow-sm"
			>
				View all projects
			</a>
		</div>
	</section>
</BaseLayout>
