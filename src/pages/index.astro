---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Portfolio Draft">
	<div class="min-h-[80vh] flex items-center justify-center">
		<div class="text-center">
			<h1 class="text-5xl font-extrabold text-content-accent mb-6">Portfolio Draft</h1>
			<p class="text-lg text-content-muted mb-8">Welcome to the portfolio development workspace.</p>
			<a href="/style-guide" class="bg-action-primary text-action-primary-content px-6 py-3 rounded-md hover:bg-action-primary-hover transition-colors font-medium">
				View Style Guide
			</a>
		</div>
	</div>
</BaseLayout>
