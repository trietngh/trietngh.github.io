---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import TypewriterTitle from "../components/TypewriterTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";

const allProjects = await getCollection("projects");

const parseProjectDate = (startedMonth?: string) => {
	if (!startedMonth) return new Date(0);
	const date = new Date(startedMonth);
	return isNaN(date.getTime()) ? new Date(0) : date;
};

const sortedProjects = allProjects.sort(
	(a, b) =>
		parseProjectDate(b.data.startedMonth).getTime() -
		parseProjectDate(a.data.startedMonth).getTime(),
);

const featuredProjects = sortedProjects
	.filter((project) => project.data.featured)
	.slice(0, 3);
---

<BaseLayout title="Triet Nguyen | Robotics Engineer" maxWidth="max-w-full">
	<!-- Main Center Content -->
	<div class="min-h-screen flex items-center justify-center relative px-4">
		<!-- Decorative Elements -->
		<div
			class="absolute pointer-events-none select-none z-50 earth-spin"
			style="top: 60%; right: 85%; width: 700px; height: 700px; opacity: 1.0; filter: invert(1); --spin-duration: 150s;"
		>
			<img
				src="/icons/earth.png"
				alt="Decorative Earth"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="absolute pointer-events-none select-none z-50"
			style="top: 87%; right: 85%; width: 100px; height: 100px; opacity: 1.0; rotate: -30deg;"
		>
			<img
				src="/icons/space_shuttle.png"
				alt="Decorative Space Shuttle"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="absolute pointer-events-none select-none z-50"
			style="top: 75%; right: 20%; width: 200px; height: 200px; opacity: 1.0;"
		>
			<img
				src="/icons/rocket.png"
				alt="Decorative Rocket"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="absolute pointer-events-none select-none z-50"
			style="top: 150%; right: 0%; width: 250px; height: 250px; opacity: 1.0;"
		>
			<img
				src="/icons/moon.png"
				alt="Decorative Moon"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="absolute pointer-events-none select-none z-50"
			style="top: 230%; right: 85%; width: 400px; height: 300px; opacity: 1.0; rotate: -30deg;"
		>
			<img
				src="/icons/saturn.png"
				alt="Decorative Saturn"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="absolute pointer-events-none select-none z-50 earth-spin"
			style="top: 220%; right: 10%; width: 100px; height: 100px; opacity: 1.0; --spin-duration: 20s;"
		>
			<img
				src="/icons/guitare.png"
				alt="Decorative Guitare"
				class="w-full h-full object-contain"
			/>
		</div>

		<div
			class="max-w-full w-full flex flex-col md:flex-row items-center justify-start gap-16 md:gap-40 md:pl-24 lg:pl-32 xl:pl-48 z-10"
		>
			<!-- Avatar (Left Side) -->
			<div class="w-128 h-128 md:w-[500px] md:h-[500px] flex-shrink-0">
				<img
					src="/icons/avatar.svg"
					alt="Avatar"
					class="w-full h-full object-contain opacity-95"
				/>
			</div>

			<!-- Text Content (Right Side) -->
			<div class="flex flex-col items-start text-left max-w-3xl">
				<!-- Mars Rover Icon -->
				<div class="w-16 h-16 md:w-32 md:h-32 mb-4">
					<img
						src="/icons/robotic_arm.svg"
						alt="Mars Rover"
						class="w-full h-full object-contain"
					/>
				</div>

				<!-- Hello Text -->
				<h1
					class="text-5xl md:text-7xl font-display font-bold text-content-main mb-4 tracking-tight leading-tight"
				>
					Hi, I'm <br class="md:hidden" /><span
						class="text-content-accent">Triet Nguyen</span
					>
				</h1>
				<TypewriterTitle />

				<!-- Discover Projects Button -->
				<a
					href="/projects"
					class="bg-action-primary text-action-primary-content px-8 py-4 rounded-2xl hover:bg-action-primary-hover transition-colors font-sans font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 duration-200 inline-block mb-10"
				>
					Discover my projects
				</a>

				<!-- Social Links -->
				<div class="flex items-center gap-4">
					<a
						href="https://github.com/trietngh"
						target="_blank"
						rel="noopener noreferrer"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/GitHub_Logos/GitHub_Invertocat_White.svg"
							alt="GitHub"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
						/>
					</a>
					<a
						href="https://linkedin.com/in/triet-nguyen-vn"
						target="_blank"
						rel="noopener noreferrer"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/LinkedIn_icon_circle.svg"
							alt="LinkedIn"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
						/>
					</a>
					<a
						href="mailto:tr_nguye@insa-toulouse.fr"
						class="text-content-muted hover:text-content-accent transition-colors transform hover:scale-110 duration-200"
					>
						<img
							src="/icons/email-round-solid-icon.svg"
							alt="Email"
							class="w-10 h-10 opacity-80 hover:opacity-100 transition-opacity"
							style="filter: invert(1);"
						/>
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- About Me Section -->
	<section
		id="about"
		class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto z-10 relative"
	>
		<div class="flex flex-col md:flex-row items-center gap-16 md:gap-24">
			<!-- Text Side -->
			<!-- Image Side -->
			<div class="w-full md:w-1/2 flex justify-center">
				<img
					src="/assets/home/profil.jpg"
					alt="A few words about me"
					class="max-w-full h-auto object-contain rounded-2xl"
				/>
			</div>
			<div class="w-full md:w-1/2 flex flex-col items-start text-left">
				<h2
					class="text-4xl md:text-5xl font-display font-bold text-content-main mb-8"
				>
					A few words <br class="md:hidden" /><span
						class="text-content-accent">about me</span
					>
				</h2>
				<p
					class="text-xl text-content-muted font-sans mb-6 text-justify"
				>
					I am a <br class="md:hidden" /><span
						class="text-content-accent"
					>
						Embedded Systems and Robotics Engineer</span
					>
					with a "jack of all trades" mindset, bridging the gap between
					low-level hardware and high-level software to build reliable,
					critical systems. Above all, I am deeply driven to <br
						class="md:hidden"
					/><span class="text-content-accent">
						develop technology that make positive impacts</span
					>, whether it is protecting the environment, expanding human
					knowledge, or improving the quality of people's life.
				</p>
				<p
					class="text-xl text-content-muted font-sans mb-6 text-justify"
				>
					I am currently completing my <br class="hidden" />
					<span class="text-content-accent">
						Engineering Degree in Critical Embedded Computing
						Systems</span
					>
					at INSA Toulouse. My professional journey includes developing
					high-precision visual localization at Framatome, as well as optimizing
					autonomous navigation systems at SEGULA Technologies.
				</p>
				<p class="text-xl text-content-muted font-sans text-justify">
					When I'm not writing code or debugging a STM32, you can find
					me reading, playing my guitar or volunteering in a local
					program.
				</p>
			</div>
		</div>
	</section>

	<!-- Projects Section -->
	<section
		id="projects"
		class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto z-10 relative"
	>
		<div class="text-center mb-16">
			<h2
				class="text-4xl md:text-5xl font-display font-bold text-content-main mb-6"
			>
				My <span class="text-content-accent">Projects</span>
			</h2>
			<p class="text-xl text-content-muted max-w-2xl mx-auto">
				Here are some of my favorite projects I've worked on.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{
				featuredProjects.map((project) => (
					<ProjectCard project={project} />
				))
			}
		</div>

		<div class="mt-16 text-center">
			<a
				href="/projects"
				class="border border-action-secondary-border text-action-secondary-content px-8 py-4 rounded-full hover:bg-action-secondary-hover transition-colors font-sans font-bold text-lg inline-block shadow-sm"
			>
				View all projects
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	@keyframes spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.earth-spin {
		animation: spin var(--spin-duration, 120s) linear infinite;
	}
</style>
