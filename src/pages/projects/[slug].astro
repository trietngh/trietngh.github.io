---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Projects`} maxWidth="max-w-4xl">
	<article class="py-24 px-4 sm:px-6 lg:px-8 mx-auto w-full">
		<a
			href="/projects"
			class="inline-flex items-center gap-2 text-content-muted hover:text-content-main transition-colors mb-8"
		>
			<svg
				class="w-5 h-5"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
			>
			Back to Projects
		</a>

		<header class="mb-12">
			{
				project.data.tags && project.data.tags.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-6">
						{project.data.tags.map((tag: string) => (
							<span class="text-action-primary-content bg-action-primary text-xs font-bold tracking-widest uppercase px-3 py-1 rounded">
								{tag}
							</span>
						))}
					</div>
				)
			}

			<h1
				class="text-4xl md:text-6xl font-display font-bold text-content-main mb-6"
			>
				{project.data.title}
			</h1>

			<p class="text-xl text-content-muted mb-8">
				{project.data.description}
			</p>

			{
				project.data.skills && project.data.skills.length > 0 && (
					<div class="flex flex-wrap gap-3">
						{project.data.skills.map((skill: string) => (
							<span class="px-4 py-2 bg-surface-main rounded-full text-sm font-medium text-content-accent border border-surface-border">
								{skill}
							</span>
						))}
					</div>
				)
			}
		</header>

		{
			project.data.image && (
				<div class="w-full h-64 md:h-96 overflow-hidden rounded-xl bg-surface-main mb-16 shadow-md border border-surface-border">
					<img
						src={project.data.image}
						alt={project.data.title}
						class="w-full h-full object-cover"
					/>
				</div>
			)
		}

		<div class="markdown-content">
			<Content />
		</div>
	</article>
</BaseLayout>

<style is:global>
	.markdown-content h1 {
		font-size: 2.25rem;
		line-height: 2.5rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-main);
		margin-top: 3rem;
		margin-bottom: 1.5rem;
	}
	.markdown-content h2 {
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-main);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}
	.markdown-content h3 {
		font-size: 1.5rem;
		line-height: 2rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-main);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	.markdown-content p {
		font-size: 1.25rem;
		line-height: 1.75rem;
		color: var(--color-content-muted);
		margin-bottom: 1.5rem;
		text-align: justify;
	}
	.markdown-content ul {
		list-style-type: disc;
		list-style-position: inside;
		font-size: 1.25rem;
		line-height: 1.75rem;
		color: var(--color-content-muted);
		margin-bottom: 1.5rem;
	}
	.markdown-content li {
		margin-bottom: 0.5rem;
	}
	.markdown-content strong {
		color: var(--color-content-main);
		font-weight: 700;
	}
	.markdown-content a {
		color: var(--color-content-accent);
		text-decoration: underline;
	}
	.markdown-content a:hover {
		text-decoration: none;
	}
</style>
