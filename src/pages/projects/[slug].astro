---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";
import calendarIconRaw from "../../../public/icons/calendar-svgrepo-com.svg?raw";
import alarmIconRaw from "../../../public/icons/alarm-svgrepo-com.svg?raw";
import tickCheckboxIconRaw from "../../../public/icons/tick-checkbox-svgrepo-com.svg?raw";

const cleanSvg = (svgStr: string) => {
	return svgStr
		.replace(/width="800px"/g, 'width="100%"')
		.replace(/height="800px"/g, 'height="100%"');
};

const calendarIcon = cleanSvg(calendarIconRaw);
const alarmIcon = cleanSvg(alarmIconRaw);
const tickCheckboxIcon = cleanSvg(tickCheckboxIconRaw);

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Projects`} maxWidth="max-w-4xl">
	<article class="py-24 px-4 sm:px-6 lg:px-8 mx-auto w-full">
		<a
			href="/projects"
			class="inline-flex items-center gap-2 text-content-muted hover:text-content-main transition-colors mb-8"
		>
			<svg
				class="w-5 h-5"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
			>
			Back to Projects
		</a>

		<header class="mb-8">
			{
				project.data.tags && project.data.tags.length > 0 && (
					<div class="flex flex-wrap gap-4 mb-6">
						{project.data.tags.map((tag: string) => (
							<span class="text-content-accent text-xs font-bold tracking-widest uppercase border-b border-surface-border pb-1">
								{tag}
							</span>
						))}
					</div>
				)
			}

			<h1
				class="text-4xl md:text-6xl font-display font-bold text-content-main mb-6"
			>
				{project.data.title}
			</h1>

			{
				(project.data.startedMonth ||
					project.data.duration ||
					project.data.status) && (
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
						{project.data.startedMonth && (
							<div class="flex items-center gap-4 bg-surface-card border border-surface-border rounded-xl py-2 px-5 shadow-sm">
								<div class="w-6 h-6 text-content-main flex-shrink-0 svg-container">
									<Fragment set:html={calendarIcon} />
								</div>
								<div class="flex flex-col text-left">
									<span class="text-sm font-display text-content-muted tracking-wide">
										Started
									</span>
									<span class="text-md font-bold font-display text-content-accent mt-0.1">
										{project.data.startedMonth}
									</span>
								</div>
							</div>
						)}
						{project.data.duration && (
							<div class="flex items-center gap-4 bg-surface-card border border-surface-border rounded-xl py-2 px-5 shadow-sm">
								<div class="w-6 h-6 text-content-main flex-shrink-0 svg-container">
									<Fragment set:html={alarmIcon} />
								</div>
								<div class="flex flex-col text-left">
									<span class="text-sm font-display text-content-muted tracking-wide">
										Duration
									</span>
									<span class="text-md font-bold font-display text-content-accent mt-0.1">
										{project.data.duration}
									</span>
								</div>
							</div>
						)}
						{project.data.status && (
							<div class="flex items-center gap-4 bg-surface-card border border-surface-border rounded-xl py-2 px-5 shadow-sm">
								<div class="w-6 h-6 text-content-main flex-shrink-0 svg-container">
									<Fragment set:html={tickCheckboxIcon} />
								</div>
								<div class="flex flex-col text-left">
									<span class="text-sm font-display text-content-muted tracking-wide">
										Status
									</span>
									<span class="text-md font-bold font-display text-content-accent mt-0.1">
										{project.data.status}
									</span>
								</div>
							</div>
						)}
					</div>
				)
			}

			<!-- <p class="text-xl text-content-muted mb-6">
				{project.data.description}
			</p> -->

			<!-- {
				project.data.skills && project.data.skills.length > 0 && (
					<div class="flex flex-wrap gap-3 mb-8">
						{project.data.skills.map((skill: string) => (
							<span class="px-4 py-2 bg-surface-main rounded-full text-sm font-medium text-content-accent border border-surface-border">
								{skill}
							</span>
						))}
					</div>
				)
			} -->

			{
				project.data.githubUrl && (
					<div class="flex">
						<a
							href={project.data.githubUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 bg-action-primary text-action-primary-content px-4 py-2 rounded-3xl hover:bg-action-primary-hover transition-colors font-bold text-sm"
						>
							Source code
							<svg
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="2.5"
								stroke="currentColor"
								class="w-4 h-4"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"
								/>
							</svg>
						</a>
					</div>
				)
			}
		</header>

		<hr class="border-t border-surface-border mb-12" />

		<ImageCarousel
			directory={project.data.imagesDir}
			fallbackImage={project.data.imageCover}
			title={project.data.title}
		/>

		<div class="markdown-content">
			<Content />
		</div>
	</article>
</BaseLayout>

<style is:global>
	.markdown-content h1 {
		font-size: 2.25rem;
		line-height: 2.5rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-accent);
		margin-top: 3rem;
		margin-bottom: 1.5rem;
	}
	.markdown-content h2 {
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-accent);
		margin-top: 2.5rem;
		margin-bottom: 1rem;
	}
	.markdown-content h3 {
		font-size: 1.5rem;
		line-height: 2rem;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--color-content-main);
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	.markdown-content p {
		font-size: 1.25rem;
		line-height: 1.75rem;
		color: var(--color-content-muted);
		margin-bottom: 1.5rem;
		text-align: justify;
	}
	.markdown-content ul {
		list-style-type: disc;
		list-style-position: inside;
		font-size: 1.25rem;
		line-height: 1.75rem;
		color: var(--color-content-muted);
		margin-bottom: 1.5rem;
	}
	.markdown-content li {
		margin-bottom: 0.5rem;
	}
	.markdown-content strong {
		color: var(--color-content-accent);
		font-weight: 700;
	}
	.markdown-content a {
		color: var(--color-content-accent);
		text-decoration: underline;
	}
	.markdown-content a:hover {
		text-decoration: none;
	}
</style>
