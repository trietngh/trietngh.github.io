---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";

const allBlogs = await getCollection("blog");
// Sort from newest to oldest
const sortedBlogs = allBlogs.sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Create search index containing title, description, and raw body
const searchIndex = sortedBlogs.map((blog) => ({
	id: blog.id,
	title: blog.data.title,
	description: blog.data.description,
	body: blog.body || "",
}));
---

<BaseLayout title="Blog | Portfolio" maxWidth="max-w-4xl">
	<div class="py-24">
		<div class="text-center mb-16">
			<h1
				class="text-4xl md:text-5xl font-display font-bold text-content-main mb-6"
			>
				Blog
			</h1>
			<p class="text-lg text-content-muted max-w-2xl mx-auto">
				Thoughts and technical write-ups on my projects and learning
				journey.
			</p>
		</div>

		<!-- Search Bar -->
		<div class="relative max-w-md mx-auto mb-12">
			<div
				class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-content-muted"
			>
				<svg
					class="w-5 h-5 opacity-70"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
			<input
				type="search"
				id="blog-search"
				placeholder="Search posts by title or content..."
				class="w-full bg-surface-card border border-surface-border rounded-2xl py-3.5 pl-12 pr-4 text-content-main placeholder:text-content-muted/50 focus:border-content-accent focus:outline-none transition-colors font-sans text-md shadow-sm"
			/>
		</div>

		<!-- No Results Message -->
		<div
			id="no-results-message"
			class="text-center py-12 bg-surface-card rounded-2xl border border-surface-border mb-8 hidden"
		>
			<p class="text-content-muted text-lg">
				No blog posts match your search.
			</p>
		</div>

		<div class="flex flex-col gap-8">
			{
				sortedBlogs.length > 0 ? (
					sortedBlogs.map((blog) => <BlogCard blog={blog} />)
				) : (
					<div class="text-center py-12 bg-surface-card rounded-lg border border-surface-border">
						<p class="text-content-muted text-lg">
							No blog posts found.
						</p>
					</div>
				)
			}
		</div>

		<div class="mt-16 text-center">
			<a
				href="/"
				class="inline-flex items-center gap-2 text-content-muted hover:text-content-main transition-colors"
			>
				<svg
					class="w-5 h-5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				Back to Home
			</a>
		</div>
	</div>
</BaseLayout>

<script define:vars={{ searchIndex }}>
	const searchInput = document.getElementById("blog-search");
	const noResultsMessage = document.getElementById("no-results-message");

	if (searchInput) {
		const handleSearch = () => {
			const query = searchInput.value.toLowerCase().trim();
			let visibleCount = 0;

			searchIndex.forEach((blog) => {
				const matchTitle = blog.title.toLowerCase().includes(query);
				const matchDescription = blog.description
					.toLowerCase()
					.includes(query);
				const matchBody = blog.body.toLowerCase().includes(query);
				const isMatch = matchTitle || matchDescription || matchBody;

				const card = document.querySelector(
					`[data-blog-id="${blog.id}"]`,
				);
				if (card) {
					if (isMatch) {
						card.classList.remove("hidden");
						visibleCount++;
					} else {
						card.classList.add("hidden");
					}
				}
			});

			if (visibleCount > 0) {
				noResultsMessage.classList.add("hidden");
			} else {
				noResultsMessage.classList.remove("hidden");
			}
		};

		searchInput.addEventListener("input", handleSearch);
		searchInput.addEventListener("search", handleSearch);
	}
</script>

<style>
	#blog-search::-webkit-search-cancel-button {
		-webkit-appearance: none;
		height: 14px;
		width: 14px;
		background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg>") center no-repeat;
		cursor: pointer;
	}
</style>
