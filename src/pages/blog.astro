---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";

const allBlogs = await getCollection("blog");
// Sort from newest to oldest
const sortedBlogs = allBlogs.sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Create search index containing title, description, and raw body
const searchIndex = sortedBlogs.map((blog) => ({
	id: blog.id,
	title: blog.data.title,
	description: blog.data.description,
	body: blog.body || "",
}));
---

<BaseLayout title="Blog | Portfolio" maxWidth="max-w-4xl">
	<div class="py-24">
		<div class="text-center mb-16">
			<h1
				class="text-4xl md:text-5xl font-display font-bold text-content-main mb-6"
			>
				Blog
			</h1>
			<p class="text-lg text-content-muted max-w-2xl mx-auto">
				Thoughts and technical write-ups on my projects and learning
				journey.
			</p>
		</div>

		<!-- Search Bar -->
		<div class="relative max-w-md mx-auto mb-12">
			<div
				class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-content-muted"
			>
				<svg
					class="w-5 h-5 opacity-70"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
			</div>
			<input
				type="search"
				id="blog-search"
				placeholder="Search posts by title or content..."
				class="w-full bg-surface-card border border-surface-border rounded-2xl py-3.5 pl-12 pr-4 text-content-main placeholder:text-content-muted/50 focus:border-content-accent focus:outline-none transition-colors font-sans text-md shadow-sm"
			/>
		</div>

		<!-- No Results Message -->
		<div
			id="no-results-message"
			class="text-center py-12 bg-surface-card rounded-2xl border border-surface-border mb-8 hidden"
		>
			<p class="text-content-muted text-lg">
				No blog posts match your search.
			</p>
		</div>

		<div class="flex flex-col gap-8">
			{
				sortedBlogs.length > 0 ? (
					sortedBlogs.map((blog) => <BlogCard blog={blog} />)
				) : (
					<div class="text-center py-12 bg-surface-card rounded-lg border border-surface-border">
						<p class="text-content-muted text-lg">
							No blog posts found.
						</p>
					</div>
				)
			}
		</div>

		<!-- Pagination Controls -->
		<div id="blog-pagination" class="flex justify-center items-center gap-3 mt-12 select-none hidden">
		</div>

		<div class="mt-16 text-center">
			<a
				href="/"
				class="inline-flex items-center gap-2 text-content-muted hover:text-content-main transition-colors"
			>
				<svg
					class="w-5 h-5"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				Back to Home
			</a>
		</div>
	</div>
</BaseLayout>

<script define:vars={{ searchIndex }}>
	const searchInput = document.getElementById("blog-search");
	const noResultsMessage = document.getElementById("no-results-message");
	const paginationContainer = document.getElementById("blog-pagination");

	const PAGE_SIZE = 10;
	let currentPage = 1;

	const handleSearch = () => {
		const query = searchInput.value.toLowerCase().trim();

		// Filter the list of blogs matching query
		const filteredBlogs = searchIndex.filter((blog) => {
			const matchTitle = blog.title.toLowerCase().includes(query);
			const matchDescription = blog.description.toLowerCase().includes(query);
			const matchBody = blog.body.toLowerCase().includes(query);
			return matchTitle || matchDescription || matchBody;
		});

		const totalMatches = filteredBlogs.length;
		const totalPages = Math.ceil(totalMatches / PAGE_SIZE) || 1;

		// Adjust current page if it is out of bounds
		if (currentPage > totalPages) {
			currentPage = totalPages;
		}
		if (currentPage < 1) {
			currentPage = 1;
		}

		// Calculate visible range for the current page
		const startIndex = (currentPage - 1) * PAGE_SIZE;
		const endIndex = startIndex + PAGE_SIZE;
		const visibleIds = new Set(
			filteredBlogs.slice(startIndex, endIndex).map((blog) => blog.id)
		);

		// Toggle visibility of blog cards
		searchIndex.forEach((blog) => {
			const card = document.querySelector(`[data-blog-id="${blog.id}"]`);
			if (card) {
				if (visibleIds.has(blog.id)) {
					card.classList.remove("hidden");
				} else {
					card.classList.add("hidden");
				}
			}
		});

		// Toggle "No results" message
		if (totalMatches > 0) {
			noResultsMessage.classList.add("hidden");
		} else {
			noResultsMessage.classList.remove("hidden");
		}

		// Render pagination controls
		renderPagination(totalPages);
	};

	const renderPagination = (totalPages) => {
		if (!paginationContainer) return;
		paginationContainer.innerHTML = "";

		// If there is only 1 page, hide pagination
		if (totalPages <= 1) {
			paginationContainer.classList.add("hidden");
			return;
		}

		paginationContainer.classList.remove("hidden");

		// Previous Button
		const prevBtn = document.createElement("button");
		prevBtn.innerHTML = `
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
			</svg>
		`;
		if (currentPage === 1) {
			prevBtn.className = "opacity-40 cursor-not-allowed pointer-events-none text-content-muted/50 border border-surface-border p-2 rounded-md";
			prevBtn.disabled = true;
		} else {
			prevBtn.className = "border border-action-secondary-border text-action-secondary-content p-2 rounded-md hover:bg-action-secondary-hover transition-colors cursor-pointer";
			prevBtn.addEventListener("click", () => {
				currentPage--;
				handleSearch();
				window.scrollTo({ top: 0, behavior: "smooth" });
			});
		}
		paginationContainer.appendChild(prevBtn);

		// Page Numbers & Ellipses Calculation
		const pages = [];
		const delta = 1; // Number of pages to show around active page

		// Always show Page 1
		pages.push(1);

		let left = currentPage - delta;
		let right = currentPage + delta;

		// Handle bounds near edges
		if (left <= 2) {
			left = 2;
			right = Math.min(left + 2 * delta, totalPages - 1);
		}
		if (right >= totalPages - 1) {
			right = totalPages - 1;
			left = Math.max(right - 2 * delta, 2);
		}

		// Left Ellipsis
		if (left > 2) {
			pages.push("...");
		}

		// Middle Pages
		for (let i = left; i <= right; i++) {
			if (i > 1 && i < totalPages) {
				pages.push(i);
			}
		}

		// Right Ellipsis
		if (right < totalPages - 1) {
			pages.push("...");
		}

		// Always show Last Page
		if (totalPages > 1) {
			pages.push(totalPages);
		}

		// Render Calculated Page Items
		pages.forEach((page) => {
			if (page === "...") {
				const ellipsisSpan = document.createElement("span");
				ellipsisSpan.textContent = "...";
				ellipsisSpan.className = "text-content-muted px-2 font-display select-none";
				paginationContainer.appendChild(ellipsisSpan);
			} else {
				const pageBtn = document.createElement("button");
				pageBtn.textContent = page.toString();
				if (page === currentPage) {
					pageBtn.className = "bg-action-primary text-action-primary-content px-4 py-2 rounded-md font-bold font-display shadow-md";
				} else {
					pageBtn.className = "border border-action-secondary-border text-action-secondary-content px-4 py-2 rounded-md hover:bg-action-secondary-hover transition-colors font-display cursor-pointer";
					pageBtn.addEventListener("click", () => {
						currentPage = page;
						handleSearch();
						window.scrollTo({ top: 0, behavior: "smooth" });
					});
				}
				paginationContainer.appendChild(pageBtn);
			}
		});

		// Next Button
		const nextBtn = document.createElement("button");
		nextBtn.innerHTML = `
			<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
			</svg>
		`;
		if (currentPage === totalPages) {
			nextBtn.className = "opacity-40 cursor-not-allowed pointer-events-none text-content-muted/50 border border-surface-border p-2 rounded-md";
			nextBtn.disabled = true;
		} else {
			nextBtn.className = "border border-action-secondary-border text-action-secondary-content p-2 rounded-md hover:bg-action-secondary-hover transition-colors cursor-pointer";
			nextBtn.addEventListener("click", () => {
				currentPage++;
				handleSearch();
				window.scrollTo({ top: 0, behavior: "smooth" });
			});
		}
		paginationContainer.appendChild(nextBtn);
	};

	if (searchInput) {
		searchInput.addEventListener("input", () => {
			currentPage = 1; // Reset to page 1 when typing
			handleSearch();
		});
		searchInput.addEventListener("search", () => {
			currentPage = 1; // Reset to page 1 when clearing
			handleSearch();
		});
	}

	// Run initial paginated display
	handleSearch();
</script>

<style>
	#blog-search::-webkit-search-cancel-button {
		-webkit-appearance: none;
		height: 14px;
		width: 14px;
		background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg>") center no-repeat;
		cursor: pointer;
	}
</style>
