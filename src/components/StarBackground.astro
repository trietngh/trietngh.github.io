---
interface Props {
  count?: number;
}

const { count = 100 } = Astro.props;

// Generate random stars on the server-side during build
const stars = Array.from({ length: count }).map(() => ({
  x: Math.random() * 100,
  y: Math.random() * 100,
  size: Math.random() * 2 + 1, // Random size between 1px and 3px
  opacity: Math.random() * 0.5 + 0.2, // Random opacity between 0.2 and 0.7
}));
---

<div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
  <!-- Randomly generated small stars -->
  {
    stars.map((star) => (
      <div
        class="absolute rounded-full bg-content-main"
        style={`
          left: ${star.x}%;
          top: ${star.y}%;
          width: ${star.size}px;
          height: ${star.size}px;
          opacity: ${star.opacity};
        `}
      />
    ))
  }

  <!-- Manually placed larger stars using the provided SVG icon -->
  <!-- Top Left -->
  <div
    class="absolute top-[15%] left-[15%] w-6 h-6 star-icon bg-content-accent opacity-80 animate-pulse"
  >
  </div>
  <!-- Top Right -->
  <div
    class="absolute top-[25%] left-[80%] w-10 h-10 star-icon bg-content-main opacity-60"
  >
  </div>
  <!-- Bottom Left -->
  <div
    class="absolute top-[80%] left-[20%] w-8 h-8 star-icon bg-content-main opacity-50"
  >
  </div>
  <!-- Bottom Right -->
  <div
    class="absolute top-[65%] left-[85%] w-12 h-12 star-icon bg-content-accent opacity-70 animate-pulse"
  >
  </div>
</div>

<style>
  .star-icon {
    mask: url("/icons/eight-pointed-star-svgrepo-com.svg") no-repeat center;
    mask-size: contain;
    -webkit-mask: url("/icons/eight-pointed-star-svgrepo-com.svg") no-repeat
      center;
    -webkit-mask-size: contain;
  }
</style>
