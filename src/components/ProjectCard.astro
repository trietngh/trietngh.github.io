---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	headingLevel?: 'h2' | 'h3';
	imageHeightClass?: string;
}

const { project, headingLevel = 'h3', imageHeightClass = 'h-48' } = Astro.props;
const { title, description, image, skills, tags } = project.data;
const url = `/projects/${project.id}`;
---

<a
	href={url}
	class="bg-surface-card rounded-lg shadow-sm border border-surface-border overflow-hidden hover:border-content-accent transition-colors block group flex flex-col"
>
	<div class={`w-full ${imageHeightClass} overflow-hidden bg-surface-main relative`}>
		{image ? (
			<img
				src={image}
				alt={title}
				class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-transform duration-500 group-hover:scale-105"
			/>
		) : (
			<div class="w-full h-full bg-surface-main flex items-center justify-center text-content-muted">
				No Image
			</div>
		)}
	</div>
	<div class="p-6 flex flex-col flex-1">
		{tags && tags.length > 0 && (
			<div class="flex flex-wrap gap-2 mb-3">
				{tags.map((tag) => (
					<span class="text-content-accent text-xs font-bold tracking-widest uppercase border-b border-surface-border pb-1">
						{tag}
					</span>
				))}
			</div>
		)}
		
		{headingLevel === 'h2' ? (
			<h2 class="text-3xl font-display font-bold text-content-main mb-3 group-hover:text-content-accent transition-colors">
				{title}
			</h2>
		) : (
			<h3 class="text-3xl font-display font-bold text-content-main mb-3 group-hover:text-content-accent transition-colors">
				{title}
			</h3>
		)}
		
		<p class="text-lg text-content-muted mb-4 flex-1">
			{description}
		</p>
		
		{skills && skills.length > 0 && (
			<div class="flex flex-wrap gap-2 mt-auto">
				{skills.map((skill) => (
					<span class="px-3 py-1 bg-surface-main rounded-full text-sm font-medium text-content-accent border border-surface-border">
						{skill}
					</span>
				))}
			</div>
		)}
	</div>
</a>
