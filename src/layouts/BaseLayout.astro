---
import "../styles/global.css";
import StarBackground from "../components/StarBackground.astro";
import Header from "../components/Header.astro";

interface Props {
	title: string;
	maxWidth?: string;
}

const { title, maxWidth = "max-w-4xl" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="/icons/fruit-food-mango-with-bg.svg"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class="bg-surface-main text-content-main font-sans min-h-screen relative"
	>
		<StarBackground />
		<Header />
		<main class={`${maxWidth} mx-auto px-4 sm:px-6 lg:px-8 relative z-10`}>
			<slot />
		</main>
	</body>
</html>
